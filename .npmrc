engine-strict=true
strict-allow-scripts=true
# 12 hours (in days): long enough for most bad releases to be pulled, short enough to take a security fix the same day.
min-release-age=0.5
# Ours, published and taken the same day, skip the floor; npm matches JSR packages by their @jsr/ name.
min-release-age-exclude[]=@dusk-network/*
min-release-age-exclude[]=@jsr/dusk__*
min-release-age-exclude[]=@jsr/duskdomains__*
min-release-age-exclude[]=@jsr/hdauven__*
allow-git=none
allow-file=none
allow-directory=none
allow-remote=none
@jsr:registry=https://npm.jsr.io
# The names our JSR packages go by here: npm takes their tarballs as the registry's, not as remote ones.
@dusk:registry=https://npm.jsr.io
@duskdomains:registry=https://npm.jsr.io
@hdauven:registry=https://npm.jsr.io
