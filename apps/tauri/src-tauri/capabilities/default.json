{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Default permissions for the Dusk Wallet main window. Stronghold: exactly the commands src/shared/vault.js calls, unload (destroy) and a wallet's removal (remove-store-record) among them; the store and fs as src/platform/storage.js and the vault use them.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "stronghold:allow-initialize",
    "stronghold:allow-load-client",
    "stronghold:allow-create-client",
    "stronghold:allow-get-store-record",
    "stronghold:allow-save-store-record",
    "stronghold:allow-remove-store-record",
    "stronghold:allow-save",
    "stronghold:allow-destroy",
    "fs:default",
    "opener:default",
    "deep-link:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/dusk-wallet.hold"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$APPDATA/dusk-wallet.hold"
        }
      ]
    }
  ]
}
